---
import DocsNav from "../components/DocsNav.astro"
import SiteFooter from "../components/SiteFooter.astro"
import SiteNav from "../components/SiteNav.astro"
import { buildDocsIndex, getPrevNextDocs } from "../lib/docs-index"
import Minimal from "./Minimal.astro"
import "../styles/prose.css"

interface Props {
  title: string
  description?: string
  slug: string
}

const { title, description, slug } = Astro.props
const docsIndex = await buildDocsIndex()
const { prev, next } = getPrevNextDocs(docsIndex, slug)
---

<Minimal title={`${title} | OpenTUI Docs`} description={description ?? "OpenTUI documentation."} wide>
  <Fragment slot="nav">
    <a class="skip" href="#docs-content">Skip to content</a>
    <SiteNav />
  </Fragment>

  <div class="docs">
    <aside>
      <DocsNav />
    </aside>

    <details>
      <summary>Contents</summary>
      <div class="contents-list">
        <DocsNav />
      </div>
    </details>

    <main id="docs-content">
      <article class="prose">
        <slot />
      </article>

      {
        (prev || next) && (
          <nav class="pager" aria-label="Documentation pages">
            {prev && (
              <a rel="prev" href={prev.url}>
                &larr; {prev.navTitle}
              </a>
            )}
            {next && (
              <a rel="next" href={next.url}>
                {next.navTitle} &rarr;
              </a>
            )}
          </nav>
        )
      }
    </main>
  </div>

  <SiteFooter />
</Minimal>

<style>
  .skip {
    position: absolute;
    left: -100vw;
  }

  .skip:focus {
    position: static;
    display: inline-block;
  }

  .docs {
    display: grid;
    grid-template-columns: 13rem minmax(0, 48rem);
    column-gap: 3rem;
    align-items: start;
    margin-block: 2.5rem 2rem;
  }

  aside {
    /* Stays below the sticky SiteNav (1.875rem wordmark + 2rem padding). */
    position: sticky;
    top: 3.875rem;
    max-height: calc(100vh - 3.875rem);
    overflow-y: auto;
    padding-block-end: 2rem;
  }

  details {
    display: none;
  }

  main {
    min-width: 0;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: var(--content-width);
    margin-block-start: 3rem;
  }

  .pager a[rel="next"] {
    margin-inline-start: auto;
    text-align: right;
  }

  @media (max-width: 60rem) {
    .docs {
      display: block;
      margin-block-start: 2rem;
    }

    aside {
      display: none;
    }

    details {
      display: block;
      margin-block-end: 2.5rem;
    }

    summary {
      cursor: pointer;
      width: fit-content;
    }

    .contents-list {
      margin-block-start: 0.75rem;
    }
  }
</style>

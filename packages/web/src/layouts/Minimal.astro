---
import SocialMeta from "../components/SocialMeta.astro"

interface Props {
  title: string
  description: string
  wide?: boolean
}

const { title, description, wide = false } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <SocialMeta {title} {description} />
    <!-- Paint the first frame with the right canvas color, before CSS loads. -->
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000000" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/BerkeleyMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      const theme = localStorage.getItem("theme")
      if (theme === "light" || theme === "dark") {
        document.documentElement.dataset.theme = theme
        const color = theme === "dark" ? "#000000" : "#ffffff"
        for (const meta of document.querySelectorAll('meta[name="theme-color"]')) meta.content = color
      }
    </script>
  </head>
  <body>
    <slot name="nav" />
    <div class:list={["page", { wide }]}>
      <slot />
    </div>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Berkeley Mono";
    src: url("/BerkeleyMono-Regular.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Berkeley Mono";
    src: url("/BerkeleyMono-Bold.woff2") format("woff2");
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Berkeley Mono";
    src: url("/BerkeleyMono-Oblique.woff2") format("woff2");
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }

  @font-face {
    font-family: "Berkeley Mono";
    src: url("/BerkeleyMono-Bold-Oblique.woff2") format("woff2");
    font-weight: 700;
    font-style: italic;
    font-display: swap;
  }

  :root {
    color-scheme: light;
    --page-background: #fff;
    --page-color: #000;
    --link-color: LinkText;
    --content-width: 36rem;
    /* Widest bounded composition: site chrome and wide pages align to it. */
    --frame-width: 64rem;
    --page-gutter: 1.5rem;
    /* Sticky header: 1.875rem wordmark + 2rem block padding. Sticky sidebars
     * and anchored headings offset by this height. */
    --site-nav-height: 3.875rem;
    /* Sticky chrome veil: the share of page background layered over the
     * backdrop blur. */
    --chrome-veil: 72%;
    --motion-step: 75ms;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--page-background);
    /* Keep the centered layout stable between pages with and without a
     * scrollbar. */
    scrollbar-gutter: stable;
  }

  body {
    margin: 0;
    padding: 4rem var(--page-gutter);
    background: var(--page-background);
    color: var(--page-color);
    font-family: "Berkeley Mono", monospace;
    line-height: 1.5;
  }

  .page {
    width: min(100%, var(--content-width));
    margin-inline: auto;
  }

  /* Wide pages (documentation): 13rem nav + 3rem gap + 48rem content. */
  .page.wide {
    width: min(100%, var(--frame-width));
  }

  /* The document title matches the wordmark's 1.875rem height, anchoring
   * the page without out-weighing the brand. Its 2.25rem line box stays
   * on the half-line grid, with display leading tighter than body text. */
  h1 {
    font-size: 1.875rem;
    line-height: 2.25rem;
  }

  h2 {
    font-size: 1.125rem;
  }

  h3 {
    font-size: 1rem;
  }

  a,
  a:visited {
    color: var(--link-color);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  /* Dark ink is off-white: pure white on pure black halates around glyphs
   * and tires the eye in long reading. Links lighten for the same reason. */
  :root[data-theme="dark"] {
    color-scheme: dark;
    --page-background: #000;
    --page-color: #ededed;
    --link-color: #4da2ff;
  }

  :root[data-theme="light"] {
    color-scheme: light;
    --page-background: #fff;
    --page-color: #000;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) {
      color-scheme: dark;
      --page-background: #000;
      --page-color: #ededed;
      --link-color: #4da2ff;
    }
  }

  @media (max-width: 40rem) {
    :root {
      --page-gutter: 1rem;
    }

    body {
      padding-block: 1.25rem 2rem;
    }
  }
</style>

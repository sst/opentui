---
import type { DividerVariant } from "../scripts/cellular-divider"

interface Props {
  variant?: DividerVariant
  class?: string
}

const { variant = "gaussian", class: className } = Astro.props
---

<div class:list={["cellular-divider-wrap", className]} aria-hidden="true">
  <canvas
    class="cellular-divider"
    data-cellular-divider={variant}
    width="672"
    height="320"
  ></canvas>
</div>

<script>
  import { mountCellularDividers } from "../scripts/cellular-divider"

  mountCellularDividers()
  document.addEventListener("astro:page-load", () => mountCellularDividers())
</script>

<style>
  .cellular-divider-wrap {
    display: flex;
    justify-content: center;
    margin: 48px 0 16px;
    overflow: hidden;
  }

  .cellular-divider {
    display: block;
    width: min(100%, 798px);
    height: auto;
    aspect-ratio: 798 / 420;
    color: var(--foreground);
  }
</style>

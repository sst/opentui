---
import OpenTUILogo from "./OpenTUILogo.astro"

const links = [
  { href: "/docs/getting-started", section: "/docs", label: "Docs" },
  { href: "/devlog", section: "/devlog", label: "Devlog" },
]

const normalize = (path: string) => path.replace(/\/+$/, "") || "/"
const current = normalize(Astro.url.pathname)
const currentValue = (href: string, section: string) => {
  if (current === normalize(href)) return "page"
  if (current === section || current.startsWith(`${section}/`)) return "true"
  return undefined
}
---

<header>
  <a class="brand" href="/" aria-label="OpenTUI home">
    <OpenTUILogo class="wordmark" />
  </a>
  <nav aria-label="Site">
    {
      links.map(({ href, section, label }) => (
        <a href={href} aria-current={currentValue(href, section)}>
          {label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-block-start: -1rem;
    padding-block: 1rem;
    background: var(--page-background);
  }

  .brand {
    display: block;
    color: inherit;
  }

  .wordmark {
    display: block;
    width: 7.8125rem;
    height: 1.875rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  nav a[aria-current] {
    color: inherit;
  }
</style>

---
import OpenTUILogo from "./OpenTUILogo.astro"

const links = [
  { href: "/docs/getting-started", section: "/docs", label: "Docs" },
  { href: "/scrollback", section: "/scrollback", label: "Scrollback" },
]

const normalize = (path: string) => path.replace(/\/+$/, "") || "/"
const current = normalize(Astro.url.pathname)
const currentValue = (href: string, section: string) => {
  if (current === normalize(href)) return "page"
  if (current === section || current.startsWith(`${section}/`)) return "true"
  return undefined
}
---

<header>
  <a class="brand" href="/" aria-label="OpenTUI home">
    <OpenTUILogo class="wordmark" />
  </a>
  <nav aria-label="Site">
    {
      links.map(({ href, section, label }) => (
        <a href={href} aria-current={currentValue(href, section)}>
          {label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  /* Site chrome: one frame width on every page, independent of the content
   * column, so the nav does not shift between routes. */
  header {
    position: sticky;
    top: 0;
    z-index: 1;
    width: min(100%, var(--frame-width));
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-block-start: -1rem;
    padding-block: 1rem;
    background: var(--page-background);
  }

  /* Content scrolling under the nav stays faintly visible. */
  @supports (backdrop-filter: blur(1px)) {
    header {
      background: color-mix(in srgb, var(--page-background) 72%, transparent);
      -webkit-backdrop-filter: blur(16px);
      backdrop-filter: blur(16px);
    }
  }

  .brand {
    display: block;
    color: inherit;
  }

  .wordmark {
    display: block;
    width: 7.8125rem;
    height: 1.875rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  nav a[aria-current] {
    color: inherit;
  }
</style>

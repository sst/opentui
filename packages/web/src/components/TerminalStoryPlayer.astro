---
interface Props {
  background?: "recorded" | "transparent"
  label: string
  loop?: boolean
  source?: string
  tone?: "recorded" | "inherit"
}

const {
  background = "recorded",
  label,
  loop = false,
  source = "/recordings/terminal-story.json",
  tone = "recorded",
} = Astro.props
---

<figure
  class="terminal-story-player"
  data-terminal-story={source}
  data-terminal-background={background}
  data-terminal-tone={tone}
  data-loop={loop || undefined}
  aria-label={label}
>
  <div class="terminal-window">
    <div class="terminal-window__screen">
      <pre data-player-screen>Enable JavaScript to play this recording.</pre>
    </div>
  </div>
  <figcaption class="terminal-player__footer">
    <span class="terminal-player__caption" data-player-caption>Loading recording...</span>
    <button class="terminal-player__toggle" type="button" data-player-toggle aria-label={`Play ${label}`}>
      <svg class="icon icon-play" viewBox="0 0 20 20" aria-hidden="true"><path d="M7 4.8v10.4l8-5.2z"></path></svg>
      <svg class="icon icon-pause" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M6 5h3v10H6zm5 0h3v10h-3z"></path>
      </svg>
      <svg class="icon icon-replay" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M5.3 6.2V3.5L2 6.8l3.3 3.3V7.5a5 5 0 1 1-.1 5.2l-1.3.8a6.5 6.5 0 1 0 1.4-7.3z"></path>
      </svg>
      <span data-player-toggle-label>Play</span>
    </button>
  </figcaption>
</figure>

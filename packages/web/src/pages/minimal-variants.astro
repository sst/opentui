---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>OpenTUI — minimal landing, 10 variants</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/BerkeleyMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <p class="meta">
      The baseline plus twelve alternative versions of the minimal landing page. Same verified facts, different writing.
      <a href="/minimal">/minimal</a> stays on the baseline (card 0) until one is selected.
    </p>

    <div class="grid">
      {
        variants.map((v) => (
          <section class="card">
            <p class="meta">
              {v.name}
              <br />
              {v.note}
            </p>
            <div class="page">
              <OpenTUILogo class="logo" title="OpenTUI" />
              <Fragment set:html={v.html} />
              <p>
                <code>bun create tui</code>
              </p>
              <p>
                <a href="/docs/getting-started">Documentation</a>
                <br />
                <a href="https://github.com/anomalyco/opentui">GitHub</a>
              </p>
              <p>
                MIT license. &copy; 2026 <a href="https://anoma.ly/">Anomaly</a>.
              </p>
            </div>
          </section>
        ))
      }
    </div>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Berkeley Mono";
    src: url("/BerkeleyMono-Regular.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  body {
    margin: 0 auto;
    padding: 2rem;
    background: #fff;
    color: #000;
    font-family: "Berkeley Mono", monospace;
    line-height: 1.5;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(24rem, 1fr));
    gap: 1.5rem;
  }

  .card {
    border: 1px solid #ccc;
  }

  .card > .meta {
    margin: 0;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid #ccc;
  }

  .meta {
    color: #666;
    font-size: 0.8125rem;
  }

  .page {
    padding: 0.25rem 1.25rem 1rem;
  }

  .logo {
    width: 150px;
    height: 36px;
    display: block;
    margin-top: 1rem;
  }

  code {
    font-family: inherit;
    font-size: inherit;
  }
</style>

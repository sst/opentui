---
// Exploration copy of /minimal built around one idea: the bullet list
// drives a film, and the film only exists while you ask for it.
//
// Default view is exactly /minimal: left-aligned text in one centered
// 56rem column, no video. The design is placement, not typography. Click
// a bullet (or j/k, arrow keys, Enter) and the row parts like a curtain:
// the list slides into the right half, the film is revealed in the left
// half, split evenly around the column's midline. Header stays above,
// footer stays below. Click the active bullet again, or press Escape,
// and the curtain closes back to the plain list.
// Transitions are 150ms linear - terminal speed, movement only, no fades.
// Below 48rem the film opens above the list instead of beside it.
//
// The placeholder files are symlinks in public/video to ~/capture. Replace
// the data-video attribute on each bullet when real captures exist.
import OpenTUILogo from "../components/OpenTUILogo.astro"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <meta
      name="description"
      content="OpenTUI is a library to build terminal user interfaces in TypeScript, React, or Solid, on a native Zig renderer."
    />
    <title>OpenTUI</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/BerkeleyMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <h1><OpenTUILogo class="logo" title="OpenTUI" /></h1>

    <p>A library to build terminal user interfaces.</p>

    <p>It powers OpenCode in production today.</p>

    <div class="band">
      <figure class="screen">
        <video src="/video/vt520.mp4" muted loop playsinline preload="metadata"></video>
      </figure>

      <ul>
        <li data-video="/video/vt520.mp4">The core is written in Zig.</li>
        <li data-video="/video/prism.mp4">Write TypeScript, React, or Solid. One renderer underneath.</li>
        <li data-video="/video/prism.mp4">Flexbox layout, with the Yoga engine compiled in.</li>
        <li data-video="/video/vt520.mp4">Each frame, it writes only the cells that changed.</li>
        <li data-video="/video/prism.mp4">Selects, inputs, text areas, and scroll boxes are built in, keybindings included.</li>
        <li data-video="/video/prism.mp4">It can play sound, show images, and render 3D.</li>
        <li data-video="/video/vt520.mp4">Test it in a script. Serve it over SSH. Compile it to one file.</li>
      </ul>
    </div>

    <p><code>bun create tui</code></p>

    <p>
      <a href="/docs/getting-started">Documentation</a><br />
      <a href="https://github.com/anomalyco/opentui">GitHub</a>
    </p>

    <p>MIT license. &copy; 2026 <a href="https://anoma.ly/">Anomaly</a>.</p>

    <script>
      const band = document.querySelector<HTMLElement>(".band")!
      const video = band.querySelector("video")!
      const list = band.querySelector("ul")!
      const points = [...band.querySelectorAll<HTMLLIElement>("li[data-video]")]
      let current: HTMLLIElement | null = null

      function open(li: HTMLLIElement) {
        const src = li.dataset.video!
        if (video.getAttribute("src") !== src) video.setAttribute("src", src)
        video.play().catch(() => {})
        band.classList.add("playing")
        current = li
        for (const point of points) point.classList.toggle("active", point === li)
      }

      function close() {
        band.classList.remove("playing")
        video.pause()
        current = null
        for (const point of points) point.classList.remove("active")
      }

      for (const li of points) {
        li.tabIndex = 0
        li.addEventListener("click", () => {
          if (current === li) close()
          else open(li)
        })
        li.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault()
            if (current === li) close()
            else open(li)
          }
        })
      }

      video.addEventListener("click", () => {
        if (video.paused) video.play().catch(() => {})
        else video.pause()
      })

      // The list behaves like an OpenTUI Select: j/k anywhere, arrow keys
      // when they cannot be needed for scrolling, wrap-around at the ends,
      // Escape dismisses the film.
      const steps: Record<string, number> = { ArrowDown: 1, j: 1, ArrowUp: -1, k: -1 }
      window.addEventListener("keydown", (event) => {
        if (event.metaKey || event.ctrlKey || event.altKey) return
        if (event.key === "Escape") {
          close()
          return
        }
        const step = steps[event.key]
        if (!step) return
        const scrollable = document.documentElement.scrollHeight > innerHeight
        if (event.key.startsWith("Arrow") && scrollable && !list.contains(document.activeElement)) return
        event.preventDefault()
        const index = current ? points.indexOf(current) : step > 0 ? -1 : 0
        open(points[(index + step + points.length) % points.length]!)
      })
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Berkeley Mono";
    src: url("/BerkeleyMono-Regular.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  body {
    max-width: 56rem;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    background: #fff;
    color: #000;
    font-family: "Berkeley Mono", monospace;
    line-height: 1.5;
  }

  .logo {
    width: 250px;
    height: 60px;
    display: block;
  }

  code {
    font-family: inherit;
    font-size: inherit;
  }

  /* The one idea: a curtain. Three fr tracks - [film] [gap] [list].
     Closed, film and gap are zero and the list is the whole column,
     exactly /minimal. Clicked, the list slides into the right half and
     the film is revealed in the left half, the divide landing on the
     column's midline. One interpolated grid transition, 150ms linear,
     movement only, no fades. */
  .band {
    display: grid;
    grid-template-columns: 0fr 0fr 1fr;
    align-items: start;
    margin-block: 1em;
    transition: grid-template-columns 150ms linear;
  }

  .band.playing {
    grid-template-columns: 15.5fr 1fr 15.5fr;
  }

  .screen {
    grid-column: 1;
    margin: 0;
    min-width: 0;
    overflow: hidden;
  }

  .band ul {
    grid-column: 3;
    margin-block: 0;
    min-width: 0;
  }

  .screen video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    cursor: pointer;
  }

  li[data-video] {
    cursor: pointer;
  }

  /* Keep the focus ring for keyboard users, skip the mousedown flash. */
  li[data-video]:focus:not(:focus-visible) {
    outline: none;
  }

  li[data-video]:hover {
    text-decoration: underline;
  }

  li.active {
    color: LinkText;
  }

  /* Narrow: the film opens above the list instead of beside it. */
  @media (max-width: 48rem) {
    .band {
      grid-template-columns: 1fr;
      grid-template-rows: 0fr auto;
      row-gap: 0;
      transition:
        grid-template-rows 150ms linear,
        row-gap 150ms linear;
    }

    .band.playing {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr auto;
      row-gap: 1.5rem;
    }

    .screen {
      grid-column: 1;
      grid-row: 1;
      min-height: 0;
    }

    .band ul {
      grid-column: 1;
      grid-row: 2;
    }
  }

  @media (max-width: 40rem) {
    body {
      padding: 2rem 1rem;
    }

    ul {
      padding-inline-start: 1.25rem;
    }

    .logo {
      width: 200px;
      height: 48px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .band {
      transition: none;
    }
  }
</style>

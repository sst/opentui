---
import BlockDivider from "../../components/BlockDivider.astro"
import ThemeToggle from "../../components/ThemeToggle.astro"
import Minimal from "../../layouts/Minimal.astro"

const samples = [
  ["pong", "Pong"],
  ["hopper", "Hopper"],
  ["roller", "Roller"],
  ["inchworm", "Inchworm"],
  ["slosh", "Slosh"],
  ["pulse", "Pulse"],
  ["piston", "Piston"],
  ["heartbeat", "Heartbeat"],
  ["equalizer", "Equalizer"],
  ["tread", "Tread"],
] as const
---

<Minimal title="Block Lab | OpenTUI" description="Unicode block separator experiments for OpenTUI.">
  <main>
    <h1>Block lab</h1>
    <p>Ten separators for the space above the primary links. Each runs briefly on load and replays on hover or tap.</p>

    <ol>
      {
        samples.map(([id, name]) => (
          <li>
            <h2>{name}</h2>
            <BlockDivider animation={id} />
            <nav class="preview-links" aria-label={`${name} preview`}>
              <a href="/docs/getting-started">Documentation</a>
              <a href="/devlog">Devlog</a>
              <a href="https://github.com/anomalyco/opentui">GitHub</a>
            </nav>
          </li>
        ))
      }
    </ol>
  </main>

  <nav aria-label="Lab">
    <a href="/">Home</a>
  </nav>

  <footer><ThemeToggle /></footer>
</Minimal>

<style>
  h1 {
    margin-block: 0 1rem;
    font-size: 1.5rem;
  }

  p {
    margin-block: 0 2rem;
  }

  ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 3rem;
    margin-block: 0 3rem;
    padding-inline-start: 2rem;
  }

  h2 {
    margin-block: 0 0.5rem;
    font-size: 1rem;
    font-weight: 400;
  }

  .preview-links {
    margin-block-start: 0.75rem;
  }

  .preview-links a {
    display: block;
    width: fit-content;
  }

  main + nav,
  footer {
    margin-block-start: 1.5rem;
  }

  nav a {
    display: block;
    width: fit-content;
  }

  @media (max-width: 30rem) {
    ol {
      grid-template-columns: 1fr;
    }
  }
</style>

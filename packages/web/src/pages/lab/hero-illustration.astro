---
import Base from "../../layouts/Base.astro"
import TerminalIllustration from "../../components/TerminalIllustration.astro"

// Real color is the entire point of these two (dispersion into a spectrum;
// chromaticity/volume/RGB-split diagrams) — recoloring by luminance would
// throw away the one thing the recording exists to show, so both use
// tone="recorded".
const colorStories = [
  {
    src: "/recordings/dispersive-prism.json",
    tone: "recorded" as const,
    title: "Spectral dispersion",
    caption: "White light, split into a spectrum by a virtual prism.",
  },
  {
    src: "/recordings/color-space-explorer.json",
    tone: "recorded" as const,
    title: "Color space",
    caption: "Chromaticity, color volume, and channel separation, in motion.",
  },
]

// The rubiks.json recording is pre-cropped to just the cube: its original
// recording had a real instructional-text panel (step description,
// algorithm notation) alongside it, which read as "a document, not
// ambiance" — the same problem that got the old ot-proportional-terminal
// recording dropped — under either tone. Luminance recoloring alone doesn't
// fix this: the source text was captured in high-luminance white/blue, so
// tone="inherit" maps it to high alpha too, just as legible as
// tone="recorded" would be. See public/recordings/README.md ("Cropping out
// UI chrome") for how the panel was actually removed. tone is left at its
// "inherit" default here only because there's no color worth preserving
// once the panel (and its notation) is gone — the bare cube's own sticker
// colors are still real captured color, just deliberately not used live.
const mixedStories = [
  ...colorStories,
  {
    src: "/recordings/rubiks.json",
    title: "Cube algorithms",
    caption: "Every solving step's algorithm, turn by turn.",
  },
  {
    src: "/recordings/anomaly.json",
    title: "Wordmark cuts",
    caption: "Thirty-one wordmark treatments, rapid-cut, non-neon.",
  },
]
---

<Base title="Hero Illustration Lab - OpenTUI" description="Isolated illustration prototypes for the hero.">
  <main class="illustration-lab">
    <section class="illustration-lab__block">
      <h2>A. contain &mdash; whole grid visible, both directions, controls hidden</h2>
      <div class="illustration-lab__stage">
        <TerminalIllustration
          label="Ambient terminal recording"
          fit="contain"
          class="illustration-lab__fill"
          stories={[colorStories[0]]}
        />
      </div>
    </section>

    <section class="illustration-lab__block">
      <h2>B. cover &mdash; full height, width crops or bleeds off the edge</h2>
      <div class="illustration-lab__stage illustration-lab__stage--narrow">
        <TerminalIllustration
          label="Ambient terminal recording"
          fit="cover"
          class="illustration-lab__fill"
          stories={[colorStories[0]]}
        />
      </div>
    </section>

    <section class="illustration-lab__block">
      <h2>C. cover &mdash; real-color stories cycling, controls on hover (move your mouse over it)</h2>
      <div class="illustration-lab__stage illustration-lab__stage--narrow">
        <TerminalIllustration
          label="Cycling terminal recordings"
          fit="cover"
          controls="hover"
          class="illustration-lab__fill"
          stories={colorStories}
        />
      </div>
    </section>

    <section class="illustration-lab__block">
      <h2>D. tone=&quot;recorded&quot;, background=&quot;recorded&quot; &mdash; a real terminal window, own colors, controls always visible</h2>
      <div class="illustration-lab__stage illustration-lab__stage--narrow illustration-lab__stage--dark">
        <TerminalIllustration
          label="Rubik's cube solve guide"
          fit="cover"
          controls="visible"
          class="illustration-lab__fill"
          stories={[
            {
              src: "/recordings/rubiks.json",
              tone: "recorded",
              background: "recorded",
              title: "Cube algorithms",
              caption: "Every solving step's algorithm, turn by turn.",
            },
          ]}
        />
      </div>
    </section>

    <section class="illustration-lab__block">
      <h2>E. All four stories cycling, mixed tone/background, controls on hover</h2>
      <div class="illustration-lab__stage illustration-lab__stage--narrow">
        <TerminalIllustration
          label="Cycling terminal recordings"
          fit="cover"
          controls="hover"
          class="illustration-lab__fill"
          stories={mixedStories}
        />
      </div>
    </section>

    <section class="illustration-lab__block">
      <h2>F. Real hero bleed geometry, standalone (light)</h2>
      <div class="hero-bleed">
        <div class="hero-illustration-bleed hero-illustration-bleed--lab">
          <TerminalIllustration
            label="Cycling terminal recordings"
            fit="cover"
            controls="hover"
            holdMs={600}
            fadeLeft={0.3}
            fadeBottom={0.35}
            class="hero-illustration"
            stories={mixedStories}
          />
        </div>
        <div class="hero-bleed__copy">
          <h1>Terminal UIs on a native Zig core.</h1>
          <p>
            Build terminal applications in TypeScript with the imperative API, React, or Solid, all on the same
            renderer. The core exposes a C ABI for any other language.
          </p>
          <div class="hero-mock__cta">
            <code>$ bun create tui</code>
            <a href="#">Read the docs &rarr;</a>
          </div>
        </div>
        <p class="hero-bleed__next">Building a terminal app.</p>
      </div>
    </section>

    <section class="illustration-lab__block">
      <h2>G. Real hero bleed geometry, standalone (dark)</h2>
      <div class="hero-bleed hero-bleed--dark">
        <div class="hero-illustration-bleed hero-illustration-bleed--lab">
          <TerminalIllustration
            label="Cycling terminal recordings"
            fit="cover"
            controls="hover"
            holdMs={600}
            fadeLeft={0.3}
            fadeBottom={0.35}
            class="hero-illustration"
            stories={mixedStories}
          />
        </div>
        <div class="hero-bleed__copy">
          <h1>Terminal UIs on a native Zig core.</h1>
          <p>
            Build terminal applications in TypeScript with the imperative API, React, or Solid, all on the same
            renderer. The core exposes a C ABI for any other language.
          </p>
          <div class="hero-mock__cta">
            <code>$ bun create tui</code>
            <a href="#">Read the docs &rarr;</a>
          </div>
        </div>
        <p class="hero-bleed__next">Building a terminal app.</p>
      </div>
    </section>
  </main>
</Base>

<style is:global>
  @import "../../styles/terminal-illustration.css";

  .illustration-lab {
    background: var(--background);
    color: var(--foreground);
    display: flex;
    flex-direction: column;
    font-family: var(--font-sans);
    gap: 64px;
    padding: 48px;
  }

  .illustration-lab__block h2 {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.02em;
    margin: 0 0 16px;
    text-transform: uppercase;
  }

  .illustration-lab__stage {
    background: var(--background);
    border: 1px dashed var(--border-color);
    height: 60vh;
    overflow: hidden;
    position: relative;
  }

  .illustration-lab__stage--narrow {
    height: 40vh;
  }

  .illustration-lab__stage--dark {
    background: #0d0e12;
    color: #f4f4f7;
  }

  .illustration-lab__fill {
    height: 100%;
    width: 100%;
  }

  .hero-bleed {
    background: #fbfbfb;
    border: 1px solid var(--border-subtle);
    height: 900px;
    overflow: hidden;
    position: relative;
  }

  .hero-bleed--dark {
    background: #0d0e12;
    color: #f4f4f7;
  }

  .hero-illustration-bleed--lab {
    display: block;
    height: clamp(480px, 46vw, 680px);
    left: 42%;
    position: absolute;
    right: -20px;
    top: 0;
    z-index: 0;
  }

  .hero-bleed__copy {
    max-width: 46ch;
    padding: 64px;
    position: relative;
    z-index: 1;
  }

  .hero-bleed__copy h1 {
    font-family: var(--font-serif);
    font-size: 40px;
    line-height: 1.05;
    margin: 0 0 20px;
  }

  .hero-bleed__copy p {
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.6;
    opacity: 0.75;
  }

  .hero-mock__cta {
    align-items: center;
    display: flex;
    gap: 20px;
    margin-top: 24px;
  }

  .hero-mock__cta code {
    background: var(--bg-subtle);
    border: 1px solid var(--border-color);
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 8px 14px;
  }

  .hero-bleed__next {
    bottom: 60px;
    font-family: var(--font-serif);
    font-size: 32px;
    left: 64px;
    margin: 0;
    position: absolute;
    z-index: 1;
  }
</style>

<script src="../../scripts/terminal-illustration.js"></script>

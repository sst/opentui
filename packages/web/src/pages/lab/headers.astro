---
import ThemeToggle from "../../components/ThemeToggle.astro"
import Minimal from "../../layouts/Minimal.astro"

const variants = [
  ["current", "1 · Mono bold, 1.25rem / 1rem — previous treatment"],
  ["scale", "2 · Mono scale — 1.5rem / 1.125rem, more air above sections — adopted"],
  ["caps", "3 · Mono caps — man-page style, tracked uppercase"],
  ["marks", "4 · Mono + markdown marks — GrayText # prefixes carry the level"],
  ["serif", "5 · System serif headings — Georgia against the mono body"],
  ["grotesk", "6 · System grotesk headings — system-ui against the mono body"],
] as const
---

<Minimal title="Header Lab | OpenTUI" description="Article heading experiments for the OpenTUI devlog.">
  <main>
    <h1>Header lab</h1>
    <p>
      Six treatments of the same devlog article header. Each sample shows the title, the meta line, a section heading,
      and a paragraph with bold text, because a section heading must not read like a bold phrase.
    </p>

    <ol>
      {
        variants.map(([id, label]) => (
          <li>
            <h2>{label}</h2>
            <div class={`sample ${id}`}>
              <p class="t1">Fixing Markdown Tables</p>
              <p class="meta">2026-02-26 · kmdr</p>
              <p>
                OpenTUI uses yoga layout and has elements called Renderables. Boxes with borders, plain text, code with
                tree-sitter backed highlighting and other primitives.
              </p>
              <p class="t2">The naive approach</p>
              <p>
                <strong>The generic path</strong> converts every argument in Node’s C++ layer and then calls the
                function through libffi. It is flexible, but also the slowest option for frequently called functions.
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </main>

  <nav aria-label="Lab">
    <a href="/">Home</a>
  </nav>

  <footer><ThemeToggle /></footer>
</Minimal>

<style>
  h1 {
    margin-block: 0 1rem;
    font-size: 1.5rem;
  }

  main > p {
    margin-block: 0 3rem;
  }

  ol {
    margin-block: 0 3rem;
    padding: 0;
    list-style: none;
  }

  li {
    margin-block-end: 4rem;
  }

  li > h2 {
    margin-block: 0 1.5rem;
    color: GrayText;
    font-size: 0.875rem;
    font-weight: 400;
  }

  .sample p {
    margin-block: 0 1rem;
  }

  .sample .t1 {
    margin-block: 0 0.25rem;
  }

  .sample .meta {
    margin-block: 0 2rem;
    color: GrayText;
  }

  .sample .t2 {
    margin-block: 2rem 0.75rem;
  }

  /* 1 · Current */
  .current .t1 {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .current .t2 {
    font-size: 1rem;
    font-weight: 700;
  }

  /* 2 · Mono scale */
  .scale .t1 {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .scale .t2 {
    margin-block-start: 2.5rem;
    font-size: 1.125rem;
    font-weight: 700;
  }

  /* 3 · Mono caps */
  .caps .t1 {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .caps .t2 {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* 4 · Mono + markdown marks */
  .marks .t1 {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .marks .t2 {
    font-size: 1rem;
    font-weight: 700;
  }

  .marks .t1::before {
    content: "# ";
    color: GrayText;
    font-weight: 400;
  }

  .marks .t2::before {
    content: "## ";
    color: GrayText;
    font-weight: 400;
  }

  /* 5 · System serif */
  .serif .t1 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .serif .t2 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.3125rem;
    font-weight: 700;
  }

  /* 6 · System grotesk */
  .grotesk .t1 {
    font-family: system-ui, "Segoe UI", Helvetica, Arial, sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .grotesk .t2 {
    font-family: system-ui, "Segoe UI", Helvetica, Arial, sans-serif;
    font-size: 1.1875rem;
    font-weight: 700;
  }

  nav a {
    display: block;
    width: fit-content;
  }

  footer {
    margin-block-start: 1rem;
  }
</style>

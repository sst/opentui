---
// The landing page is built around one idea: the bullet list drives a film,
// and the film only exists while you ask for it.
//
// Default view is a centered, left-aligned text column with no video. Click
// a bullet (or j/k, arrow keys, Enter) and the list makes room for a film on
// the right. On narrower screens the film opens above the list instead.
// Click the active bullet again, or press Escape, to return to the plain list.
// Transitions are 150ms linear - terminal speed, movement only, no fades.
// At 64rem and below the film opens above the list instead of beside it.
//
// The placeholder files are symlinks in public/video to ~/capture. Replace
// the data-video attribute on each bullet when real captures exist.
import OpenTUILogo from "../components/OpenTUILogo.astro"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="OpenTUI is a library to build terminal user interfaces in TypeScript, React, or Solid, on a native Zig renderer."
    />
    <title>OpenTUI</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/BerkeleyMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <h1><OpenTUILogo class="logo" title="OpenTUI" /></h1>

    <p>A library to build terminal user interfaces.</p>

    <div class="band">
      <figure class="screen">
        <video src="/video/vt520.mp4" muted loop playsinline preload="metadata"></video>
      </figure>

      <ul>
        <li data-video="/video/vt520.mp4">It is written in Zig.</li>
        <li data-video="/video/prism.mp4">You write TypeScript, React, or Solid. Other languages can use the C ABI.</li>
        <li data-video="/video/prism.mp4">You arrange boxes and text with flexbox.</li>
        <li data-video="/video/vt520.mp4">You add selects, inputs, and scroll boxes with keyboard and mouse controls.</li>
        <li data-video="/video/prism.mp4">You can play sounds, show images, and render 3D graphics.</li>
      </ul>
    </div>

    <p>OpenCode uses it in production for millions of users.</p>

    <p>
      <a href="/docs/getting-started">Documentation</a><br />
      <a href="/blog">Blog</a><br />
      <a href="https://github.com/anomalyco/opentui">GitHub</a>
    </p>

    <p>MIT license. &copy; 2026 <a href="https://anoma.ly/">Anomaly</a>.</p>

    <script>
      const band = document.querySelector<HTMLElement>(".band")!
      const video = band.querySelector("video")!
      const list = band.querySelector("ul")!
      const points = [...band.querySelectorAll<HTMLLIElement>("li[data-video]")]
      let current: HTMLLIElement | null = null

      function open(li: HTMLLIElement) {
        const src = li.dataset.video!
        if (video.getAttribute("src") !== src) video.setAttribute("src", src)
        video.play().catch(() => {})
        band.classList.add("playing")
        current = li
        for (const point of points) point.classList.toggle("active", point === li)
      }

      function close() {
        band.classList.remove("playing")
        video.pause()
        current = null
        for (const point of points) point.classList.remove("active")
      }

      for (const li of points) {
        li.tabIndex = 0
        li.addEventListener("click", () => {
          if (current === li) close()
          else open(li)
        })
        li.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault()
            if (current === li) close()
            else open(li)
          }
        })
      }

      video.addEventListener("click", () => {
        if (video.paused) video.play().catch(() => {})
        else video.pause()
      })

      // The list behaves like an OpenTUI Select: j/k anywhere, arrow keys
      // when they cannot be needed for scrolling, wrap-around at the ends,
      // Escape dismisses the film.
      const steps: Record<string, number> = { ArrowDown: 1, j: 1, ArrowUp: -1, k: -1 }
      window.addEventListener("keydown", (event) => {
        if (event.metaKey || event.ctrlKey || event.altKey) return
        if (event.key === "Escape") {
          close()
          return
        }
        const step = steps[event.key]
        if (!step) return
        const scrollable = document.documentElement.scrollHeight > innerHeight
        if (event.key.startsWith("Arrow") && scrollable && !list.contains(document.activeElement)) return
        event.preventDefault()
        const index = current ? points.indexOf(current) : step > 0 ? -1 : 0
        open(points[(index + step + points.length) % points.length]!)
      })
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Berkeley Mono";
    src: url("/BerkeleyMono-Regular.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  body {
    margin: 0;
    padding: 4rem 1.5rem;
    background: #fff;
    color: #000;
    font-family: "Berkeley Mono", monospace;
    line-height: 1.5;
  }

  body > :not(script, style) {
    width: min(100%, 36rem);
    margin-inline: auto;
  }

  .logo {
    display: block;
    width: 250px;
    height: 60px;
  }

  code {
    font-family: inherit;
    font-size: inherit;
  }

  /* The list stays on the page's text spine while the video grows to its
     right. The header and footer remain on that axis, and one shared seam
     prevents overlap. */
  .band {
    position: relative;
    width: min(100%, 36rem);
    margin-inline: auto;
    margin-block: 1em;
    transition: width 75ms linear 75ms;
  }

  .band.playing {
    width: min(100%, 56rem);
    transition-delay: 0ms;
  }

  .screen {
    position: absolute;
    inset: 0 0 auto auto;
    width: 22rem;
    margin: 0;
    overflow: hidden;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 75ms linear;
  }

  .band.playing .screen {
    clip-path: inset(0);
    transition-delay: 75ms;
  }

  .band ul {
    box-sizing: border-box;
    margin-block: 0;
    width: 100%;
    transition: width 75ms linear 75ms;
  }

  .band.playing ul {
    width: calc(100% - 23.5rem);
    transition-delay: 0ms;
  }

  .screen video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    cursor: pointer;
  }

  li[data-video] {
    cursor: pointer;
  }

  /* Keep the focus ring for keyboard users, skip the mousedown flash. */
  li[data-video]:focus:not(:focus-visible) {
    outline: none;
  }

  li[data-video]:hover {
    text-decoration: underline;
  }

  li.active {
    color: LinkText;
  }

  /* If the full two-pane composition cannot retain comfortable gutters,
     keep the compact measure and stack the same two surfaces. */
  @media (max-width: 64rem) {
    .band {
      position: static;
      display: grid;
      margin-inline: auto;
      width: min(100%, 36rem);
      grid-template-columns: 1fr;
      grid-template-rows: 0fr auto;
      row-gap: 0;
      transition:
        grid-template-rows 150ms linear,
        row-gap 150ms linear;
    }

    .band.playing {
      width: min(100%, 36rem);
      grid-template-columns: 1fr;
      grid-template-rows: 1fr auto;
      row-gap: 1.5rem;
    }

    .screen {
      position: static;
      width: auto;
      grid-column: 1;
      grid-row: 1;
      min-height: 0;
      clip-path: none;
      transition: none;
    }

    .band ul,
    .band.playing ul {
      width: auto;
      grid-column: 1;
      grid-row: 2;
      transition: none;
    }

    .screen video {
      width: 100%;
    }
  }

  @media (max-width: 40rem) {
    body {
      padding: 2rem 1rem;
    }

    ul {
      padding-inline-start: 1.25rem;
    }

    .logo {
      width: 200px;
      height: 48px;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .band,
    .screen,
    .screen video,
    .band ul {
      transition: none;
    }
  }
</style>

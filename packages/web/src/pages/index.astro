      { title: "Sixel 6-Pixel Scanline Bands", words: "3.5K WORDS", slug: "/docs/components/image" },
      { title: "Unicode Quadrant Half-Blocks", words: "2.8K WORDS", slug: "/docs/components/frame-buffer" },
      { title: "Native Miniaudio & PCM Streams", words: "3.9K WORDS", slug: "/docs/core-concepts/audio" },
    ]
  },
  {

---
import Base from "../layouts/Base.astro"
import OpenTUILogo from "../components/OpenTUILogo.astro"

// All listings are adapted from the docs pages they cite; they use only API
// shown on those pages and must be re-verified when those pages change.
const coreListing = `import { createCliRenderer, Box, Text } from "@opentui/core"

const renderer = await createCliRenderer()

renderer.root.add(
  Box(
    { borderStyle: "rounded", padding: 1 },
    Text({ content: "Hello, OpenTUI!" }),
  ),
)`

// Captured with createTestRenderer({ width: 25, height: 5 }) via
// setup.captureCharFrame(); regenerate if the listings change.
const capturedFrame = `╭───────────────────────╮
│                       │
│ Hello, OpenTUI!       │
│                       │
╰───────────────────────╯`

// FIG_02-05 are short fragments that continue an existing "renderer" in
// scope (imports omitted) so lines stay narrow enough for the 3-column flow.
const layoutListing = `Box(
  { flexDirection: "row", width: "100%" },
  Box(
    { width: 24, border: true },
    Text({ content: "Sidebar" }),
  ),
  Box(
    { flexGrow: 1, padding: 1 },
    Text({ content: "Content" }),
  ),
)`

const codeComponentListing = `new CodeRenderable(renderer, {
  content: "const answer = 42",
  filetype: "typescript",
  width: 34,
  syntaxStyle: SyntaxStyle.fromStyles({
    keyword: { fg: RGBA.fromHex("#ff7b72") },
    number: { fg: RGBA.fromHex("#79c0ff") },
  }),
})`

const tableListing = `new TextTableRenderable(renderer, {
  width: "100%",
  borderStyle: "rounded",
  content: [
    [[bold("Service")], [bold("Status")]],
    [[fg("#999")("api")], [fg("#2c5")("OK")]],
    [[fg("#999")("job")], [fg("#f90")("BUSY")]],
  ],
})`

const imageListing = `const panel = new BoxRenderable(renderer, {
  flexDirection: "column",
  gap: 1,
})
panel.add(new ImageRenderable(renderer, {
  source: "./cover.webp",
  width: 40,
  height: 15,
  fit: "cover",
}))
panel.add(new TextRenderable(renderer, {
  content: "Now playing",
  fg: "#38bdf8",
}))
renderer.root.add(panel)`

const indexData = [
  {
    part: "PART I: FIRST FRAME",
    entries: [
      { title: "Getting started", meta: "GUIDE", slug: "/docs/getting-started" },
      { title: "Renderer lifecycle", meta: "CORE CONCEPT", slug: "/docs/core-concepts/renderer" },
      { title: "Renderables", meta: "CORE CONCEPT", slug: "/docs/core-concepts/renderables" },
      { title: "Layout system", meta: "CORE CONCEPT", slug: "/docs/core-concepts/layout" },
    ]
  },
  {
    part: "PART II: TEXT, COLOR, AND CELLS",
    entries: [
      { title: "Text", meta: "COMPONENT", slug: "/docs/components/text" },
      { title: "Colors", meta: "CORE CONCEPT", slug: "/docs/core-concepts/colors" },
      { title: "Frame buffer", meta: "COMPONENT", slug: "/docs/components/frame-buffer" },
      { title: "Color matrix", meta: "REFERENCE", slug: "/docs/reference/color-matrix" },
    ]
  },
  {
    part: "PART III: INPUT AND COMPONENTS",
    entries: [
      { title: "Keyboard and input", meta: "CORE CONCEPT", slug: "/docs/core-concepts/keyboard" },
      { title: "Input component", meta: "COMPONENT", slug: "/docs/components/input" },
      { title: "Image component", meta: "COMPONENT", slug: "/docs/components/image" },
      { title: "Testing", meta: "CORE CONCEPT", slug: "/docs/core-concepts/testing" },
    ]
  },
  {
    part: "PART IV: APIS AND TRANSPORTS",
    entries: [
      { title: "React", meta: "BINDING", slug: "/docs/bindings/react" },
      { title: "Solid", meta: "BINDING", slug: "/docs/bindings/solid" },
      { title: "SSH", meta: "REFERENCE", slug: "/docs/reference/ssh" },
      { title: "Package entrypoints", meta: "REFERENCE", slug: "/docs/reference/package-entrypoints" },
    ]
  }
]
---

<Base
  title="OpenTUI - Terminal UIs on a native Zig core"
  description="Build interactive terminal applications with TypeScript, React, or Solid on OpenTUI's native Zig core."
>
  <div class="editorial-wrapper">
    <div class="editorial-container">

      <!-- Quiet Editorial Masthead: no brand mark here, the logo below is the page's one brand occurrence -->
      <div class="editorial-masthead">
        <div class="editorial-masthead-nav">
          <a href="/docs/getting-started">Documentation</a>
          <a href="https://github.com/anomalyco/opentui" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>

      <!-- Product Hero -->
      <header class="editorial-hero">
        <OpenTUILogo class="hero-logo-mark" title="OpenTUI" />

        <div class="hero-grid">
          <div class="hero-copy">
            <h1 class="hero-headline">
              Terminal UIs on a native Zig core.
            </h1>
            <p class="editorial-lead-desc">
              OpenTUI is a TypeScript library for building interactive terminal applications. Write components with the imperative API, or with React and Solid over the same renderer. Yoga resolves Flexbox layout, and a native Zig core turns each frame into terminal output.
            </p>
            <div class="hero-start">
              <code class="hero-start-cmd">$ bun create tui</code>
              <a class="hero-start-link" href="/docs/getting-started">Read the docs &rarr;</a>
            </div>
          </div>

          <figure class="hero-figure">
            <div class="hero-terminal">
              <div class="hero-terminal-bar">
                <span class="hero-terminal-dot"></span>
                <span class="hero-terminal-dot"></span>
                <span class="hero-terminal-dot"></span>
                <span class="hero-terminal-name">hello.ts</span>
              </div>
              <pre class="hero-terminal-body"><code>{capturedFrame}</code></pre>
            </div>
            <figcaption class="hero-figure-caption">Output of the four lines in <a href="#fig-01">FIG_01</a>.</figcaption>
          </figure>
        </div>
      </header>

      <div class="section-rule" aria-hidden="true"></div>

      <!-- Illustrated Introduction: Front Matter -->
      <section class="editorial-frontmatter">
        <h2 class="frontmatter-title">Let's build a terminal app.</h2>
        <p class="frontmatter-subtitle">
          You'll start with one component and end with something you could ship.
        </p>
      </section>

      <p class="editorial-intro">
        Build a tree of boxes, text, tables, and images. Lay it out with the Flexbox you already know, wire up keyboard and mouse input, and OpenTUI turns the result into terminal output &mdash; on your machine, over SSH, or compiled into a single binary. Here's the smallest version of that tree.
      </p>

      <!-- FIG_01: The interface you write -->
      <figure class="editorial-figure editorial-lead-figure" id="fig-01">
        <span class="fig-tag-top-left">FIG_01</span>
        <span class="fig-tag-top-right">[ ONE RENDERABLE TREE ]</span>

        <div class="figure-code-grid">
          <div>
            <span class="figure-code-label">Source</span>
            <pre class="figure-code"><code>{coreListing}</code></pre>
          </div>
          <div>
            <span class="figure-code-label">Output</span>
            <div class="figure-output-wrap">
              <pre class="figure-output"><code>{capturedFrame}</code></pre>
            </div>
          </div>
        </div>

        <div class="figure-caption-text">
          <code>renderer.root.add(...)</code> attaches this tree; the renderer resolves it into the frame above. <code>@opentui/react</code> and <code>@opentui/solid</code> build the same renderables from JSX over the same renderer.
        </div>
      </figure>

      <p class="editorial-intro-links">
        <a href="/docs/getting-started">Getting started</a> &middot; <a href="/docs/core-concepts/renderables">Renderables</a> &middot; <a href="/docs/bindings/react">React</a> &middot; <a href="/docs/bindings/solid">Solid</a>
      </p>

      <!-- Editorial Multi-Column Flow -->
      <div class="editorial-flow">

        <p>
          One component is not an app. Nest boxes, set <code>flexDirection</code>, <code>flexGrow</code>, and <code>gap</code>, and OpenTUI lays out the tree the way CSS Flexbox would: a sidebar beside a scrolling pane, a header pinned above a body, a status line pinned below. You describe relationships between elements, not pixel offsets, and OpenTUI resolves them against however many rows and columns the terminal actually has.
        </p>

        <p>
          Resize the terminal and the same tree resolves again against the new size; nothing you wrote changes. That property &mdash; a layout that survives a resize without a rewrite &mdash; is what makes a terminal app feel like an app, not a script that happens to print boxes.
        </p>

        <!-- FIG_02: Layout & composition -->
        <figure class="editorial-figure">
          <span class="fig-tag-top-left">FIG_02</span>
          <span class="fig-tag-top-right">[ SIDEBAR + CONTENT ]</span>

          <span class="figure-code-label">Source</span>
          <pre class="figure-code"><code>{layoutListing}</code></pre>

          <div class="figure-placeholder" aria-hidden="true">Capture pending &mdash; rendered at 60&times;20, then resized live</div>

          <div class="figure-caption-text">
            A 24-column sidebar and a growing content pane, in four lines. Every measurement here is relative &mdash; resize the terminal and this tree resolves again on its own.
          </div>
          <span class="fig-tag-bottom-left">LAYOUT</span>
          <span class="fig-tag-bottom-right">FLEX &rarr; CELLS</span>
        </figure>

        <p class="flow-refs">
          Continue reading: <a href="/docs/core-concepts/layout">Layout system</a> &middot; <a href="/docs/core-concepts/renderables">Renderables</a>
        </p>

        <p>
          Layout gives you structure; components give you substance. Beyond <code>Box</code> and <code>Text</code>, the library includes <code>Select</code> for menus, <code>Input</code> and <code>TextArea</code> for entry, <code>TextTable</code> for tabular data with per-cell styling, <code>Markdown</code> and syntax-highlighted <code>Code</code> for prose and source, <code>Image</code> for real pictures, and more &mdash; scrollboxes, tabs, sliders, ASCII banners, QR codes &mdash; all built from the same renderables as the box in FIG_01.
        </p>

        <p>
          <code>Code</code> highlights source with Tree-sitter, the same parser technology editors use, so a log viewer or diff tool gets real syntax colors instead of a best-effort regex. None of this requires leaving the renderable tree: a table and a syntax-highlighted panel compose exactly like two boxes do.
        </p>

        <!-- FIG_03: The component library -->
        <figure class="editorial-figure">
          <span class="fig-tag-top-left">FIG_03</span>
          <span class="fig-tag-top-right">[ TWO OF THE LIBRARY ]</span>

          <span class="figure-code-label">Code</span>
          <pre class="figure-code"><code>{codeComponentListing}</code></pre>

          <span class="figure-code-label">TextTable</span>
          <pre class="figure-code"><code>{tableListing}</code></pre>

          <div class="figure-caption-text">
            Two of the library's components, declared the same way as the tree in FIG_01: accurately highlighted source above, a styled and bordered table below.
          </div>
          <span class="fig-tag-bottom-left">OPENTUI CORE</span>
          <span class="fig-tag-bottom-right">CODE &middot; TEXTTABLE</span>
        </figure>

        <p class="flow-refs">
          Continue reading: <a href="/docs/components/code">Code</a> &middot; <a href="/docs/components/text-table">Text table</a> &middot; <a href="/docs/components/markdown">Markdown</a> &middot; <a href="/docs/components/select">Select</a>
        </p>

        <p>
          Every one of those components can take focus, and focus is what makes a terminal app interactive rather than a poster. When a component has focus, keyboard events route to it; <code>renderer.keyInput</code> emits structured key events with the parsed key name, modifiers, and the original terminal sequence, and paste arrives as its own event. <code>Select</code> turns arrow keys and <code>Enter</code> into an <code>ITEM_SELECTED</code> event without you writing a key-matching switch statement yourself.
        </p>

        <p>
          Mouse events follow the same resolved bounds layout already computed, and the whole interaction surface is testable: <code>createTestRenderer</code> drives real key and mouse events against a real render loop, so you can assert on behavior instead of eyeballing a terminal.
        </p>

        <p class="flow-refs">
          Continue reading: <a href="/docs/core-concepts/keyboard">Keyboard and input</a> &middot; <a href="/docs/components/select">Select</a> &middot; <a href="/docs/core-concepts/testing">Testing</a>
        </p>

        <p>
          Terminals are not limited to sixteen colors and block characters anymore, and OpenTUI does not pretend otherwise. Every color is a full RGBA value, and <code>Image</code> decodes PNG, JPEG, WebP, and GIF into whatever the terminal actually supports &mdash; Kitty graphics, Sixel, or Unicode blocks &mdash; so a real photo, not an ASCII approximation, sits inside your layout next to ordinary text.
        </p>

        <p>
          Color is not only for content: <code>colorMatrix</code> and <code>colorMatrixUniform</code> apply 4&times;4 RGBA transforms &mdash; invert, desaturate, sepia &mdash; directly to a frame buffer, the same primitive image editors use, running on your terminal's cells.
        </p>

        <!-- FIG_04: Color & real images -->
        <figure class="editorial-figure">
          <span class="fig-tag-top-left">FIG_04</span>
          <span class="fig-tag-top-right">[ IMAGE + TEXT, ONE TREE ]</span>

          <span class="figure-code-label">Source</span>
          <pre class="figure-code"><code>{imageListing}</code></pre>

          <div class="figure-placeholder" aria-hidden="true">Capture pending &mdash; Kitty, Sixel, and block fallback, side by side</div>

          <div class="figure-caption-text">
            A cover image and a status line, declared together. Which bytes actually reach your terminal &mdash; Kitty, Sixel, or blocks &mdash; depends on what the terminal reports, not on what you wrote.
          </div>
          <span class="fig-tag-bottom-left">IMAGERENDERABLE</span>
          <span class="fig-tag-bottom-right">KITTY &middot; SIXEL &middot; BLOCKS</span>
        </figure>

        <p class="flow-refs">
          Continue reading: <a href="/docs/components/image">Image component</a> &middot; <a href="/docs/core-concepts/colors">Colors</a> &middot; <a href="/docs/reference/color-matrix">Color matrix</a>
        </p>

        <p>
          Everything above runs through <code>CliRenderer</code>, and <code>CliRenderer</code> is not tied to your machine. Use the imperative API directly, or let <code>@opentui/react</code> or <code>@opentui/solid</code> drive the identical renderables through JSX &mdash; same renderer, same components, different syntax. <code>@opentui/ssh</code> turns each accepted SSH connection into its own <code>CliRenderer</code>, so the app you just built can serve multiple remote users at once, in whichever of the three APIs you already wrote it in.
        </p>

        <p>
          Bun can compile the whole thing &mdash; native library, parsers, and grammars included &mdash; into one executable with <code>bun build --compile</code>; Node.js single-executable applications work too. What you built as a script becomes something you can hand someone as a single file.
        </p>

        <!-- FIG_05: One renderer, everywhere it runs -->
        <figure class="editorial-figure">
          <span class="fig-tag-top-left">FIG_05</span>
          <span class="fig-tag-top-right">[ ONE RENDERER, THREE WAYS OUT ]</span>

          <div class="figure-placeholder" aria-hidden="true">Diagram pending &mdash; CliRenderer branching to a local terminal, an SSH session, and a compiled binary</div>

          <div class="figure-caption-text">
            The same renderer sits underneath a local terminal session, a remote SSH session, and a compiled binary. Nothing about the component tree changes between them.
          </div>
          <span class="fig-tag-bottom-left">CLIRENDERER</span>
          <span class="fig-tag-bottom-right">LOCAL &middot; SSH &middot; BINARY</span>
        </figure>

        <p class="flow-refs">
          Continue reading: <a href="/docs/bindings/react">React</a> &middot; <a href="/docs/bindings/solid">Solid</a> &middot; <a href="/docs/reference/ssh">SSH</a> &middot; <a href="/docs/reference/standalone-executables">Standalone executables</a>
        </p>

        <p>
          None of this is hypothetical: OpenTUI already powers OpenCode in production, and will power terminal.shop next.
        </p>

        <p>
          You have now seen the shape of it: components and layout, interaction and testing, color and images, and the reach to run anywhere from a laptop to an SSH session to a single compiled binary. The index below follows each piece into the documentation &mdash; including <a href="/docs/core-concepts/rendering-pipeline">how the renderer resolves all of it</a> beneath the tree you write.
        </p>

      </div>

      <div class="section-rule" aria-hidden="true"></div>

      <!-- Reading Index -->
      <section class="toc-section" id="index">
        <div class="toc-header">
          <h2 class="toc-heading">Reading index.</h2>
          <span class="toc-version">DOCUMENTATION ROUTES</span>
        </div>

        <div class="toc-grid">
          {indexData.map((part) => (
            <div class="toc-part-card">
              <div class="toc-part-label">{part.part}</div>
              <ul class="toc-chapter-list">
                {part.entries.map((entry) => (
                  <li class="toc-chapter-item">
                    <a href={entry.slug}>
                      <span>{entry.title}</span>
                      <span class="chapter-words">{entry.meta}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- Editorial Footer -->
      <footer class="editorial-footer">
        <div class="footer-top">
          <div class="footer-identity">
            <OpenTUILogo class="footer-logo-mark" />
            <span style="font-weight: 500; color: var(--foreground);">LET'S BUILD A TERMINAL APP</span>
          </div>
          <div class="footer-links">
            <a href="/docs/getting-started">Documentation</a>
            <a href="/docs/core-concepts/renderer">Renderer</a>
            <a href="/docs/core-concepts/layout">Layout</a>
            <a href="https://github.com/anomalyco/opentui" target="_blank" rel="noopener noreferrer">GitHub</a>
          </div>
        </div>

        <div class="footer-bottom">
          <div>Open source under the MIT License &middot; Native Zig and TypeScript</div>
          <div>ANOMALY</div>
        </div>
      </footer>

    </div>
  </div>
</Base>

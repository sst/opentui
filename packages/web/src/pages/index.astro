      { title: "Yoga Flexbox Grid Quantization", words: "6.2K WORDS", slug: "/docs/core-concepts/layout" },
      { title: "4×4 RGBA SIMD Color Matrices", words: "3.7K WORDS", slug: "/docs/reference/color-matrix" },

  </div>
</Base>

<script>
  // Laboratory Bench Tab Switching
  const benchTabs = document.querySelectorAll('.bench-tab')
  const benchPanels = document.querySelectorAll('.bench-content-panel')

  benchTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      benchTabs.forEach(t => t.setAttribute('aria-selected', 'false'))
      tab.setAttribute('aria-selected', 'true')
      const target = tab.getAttribute('data-bench-tab')
      benchPanels.forEach((p) => {
        p.setAttribute('data-active', p.getAttribute('data-bench-panel') === target ? 'true' : 'false')
      })
    })
  })

  // Lab: Delta Stream Mutator
  const labBtnMutate = document.getElementById('lab-btn-mutate')
  const labBtnRepaint = document.getElementById('lab-btn-repaint')
  const labDiffToken = document.getElementById('lab-diff-token')
  const labEscapeStream = document.getElementById('lab-escape-stream')

  const tokens = ["render_loop_", "damage_matrix_", "yoga_flexbox_", "simd_vector_", "ssh_daemon_"]
  let tIdx = 0

  labBtnMutate?.addEventListener('click', () => {
    tIdx = (tIdx + 1) % tokens.length
    const tok = tokens[tIdx]
    if (labDiffToken) labDiffToken.textContent = tok
    if (labEscapeStream) {
      labEscapeStream.innerHTML = `\\x1b[4;13H\\x1b[38;2;16;185;129m${tok}\\x1b[0m <span style="color: var(--emerald-600); float: right;">[34 BYTES]</span>`
    }
  })

  labBtnRepaint?.addEventListener('click', () => {
    if (labEscapeStream) {
      labEscapeStream.innerHTML = `\\x1b[2J\\x1b[H\\x1b[38;2;255;255;255m[FULL SCREEN REPAINT OVER STDIO: 3,840 BYTES TRANSMITTED]`
    }
  })

  // Lab: Color Matrix Grading
  const labGlyphSwatches = document.getElementById('lab-glyph-swatches')
  const labMatrixReadout = document.getElementById('lab-matrix-readout')
  const glyphs = ['█', '▓', '▒', '░', '◆', '▲', '●', '✦', 'Z', 'I', 'G', '0', 'T', 'U', 'I', '1']

  const matrixPresets: Record<string, { r: number; g: number; b: number; desc: string }> = {
    default: { r: 1.0, g: 1.0, b: 1.0, desc: "R' = 1.00·R, G' = 1.00·G, B' = 1.00·B" },
    amber: { r: 1.8, g: 1.1, b: 0.2, desc: "R' = 1.80·R, G' = 1.10·G, B' = 0.20·B (AMBER CRT)" },
    green: { r: 0.2, g: 1.9, b: 0.4, desc: "R' = 0.20·R, G' = 1.90·G, B' = 0.40·B (VT220 GREEN)" },
    sepia: { r: 1.4, g: 1.1, b: 0.7, desc: "R' = 1.40·R, G' = 1.10·G, B' = 0.70·B (SEPIA ARCHIVE)" },
  }

  function renderSwatches(pKey: string) {
    const p = matrixPresets[pKey] || matrixPresets.default
    if (labMatrixReadout) labMatrixReadout.innerHTML = p.desc
    if (labGlyphSwatches) {
      labGlyphSwatches.innerHTML = glyphs.map((g, i) => {
        const baseR = (i * 18 + 40) % 255
        const baseG = (i * 22 + 60) % 255
        const baseB = (i * 26 + 80) % 255

        const tr = Math.min(255, Math.floor(baseR * p.r))
        const tg = Math.min(255, Math.floor(baseG * p.g))
        const tb = Math.min(255, Math.floor(baseB * p.b))

        return `<div style="background: rgb(${Math.floor(tr*0.2)}, ${Math.floor(tg*0.2)}, ${Math.floor(tb*0.2)}); color: rgb(${tr}, ${tg}, ${tb}); display: flex; align-items: center; justify-content: center; height: 28px; font-family: var(--font-mono); font-size: 12px; font-weight: bold;">${g}</div>`
      }).join('')
    }
  }

  document.querySelectorAll('[data-lab-preset]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-lab-preset]').forEach(b => b.classList.remove('active'))
      btn.classList.add('active')
      const p = btn.getAttribute('data-lab-preset') || 'default'
      renderSwatches(p)
    })
  })
  renderSwatches('default')

  // Lab: Yoga Quantizer Slider
  const labYogaSlider = document.getElementById('lab-yoga-slider') as HTMLInputElement
  const labYogaNav = document.getElementById('lab-yoga-nav')
  const labYogaMain = document.getElementById('lab-yoga-main')

  labYogaSlider?.addEventListener('input', () => {
    const totalCols = parseInt(labYogaSlider.value, 10)
    const navCols = Math.floor(totalCols * 0.3333)
    const mainCols = totalCols - navCols

    if (labYogaNav) {
      labYogaNav.style.width = `${(navCols / totalCols) * 100}%`
      labYogaNav.textContent = `${navCols} CH (33.3%)`
    }
    if (labYogaMain) {
      labYogaMain.style.width = `${(mainCols / totalCols) * 100}%`
      labYogaMain.textContent = `${mainCols} CH (66.7%)`
    }
  })
</script>

            <a href="/docs/getting-started">Documentation</a>
            <a href="/docs/core-concepts/renderer">Renderer</a>
            <a href="/docs/core-concepts/layout">Layout</a>
            <a href="https://github.com/anomalyco/opentui" target="_blank" rel="noopener noreferrer">GitHub</a>
          </div>
        </div>

        <div class="footer-bottom">
          <div>Published under the MIT License &middot; Written in Native Zig &amp; TypeScript</div>
          <div>ESTABLISHED 2026 &middot; ANOMALY</div>
        </div>

              <button role="tab" class="bench-tab" data-bench-tab="code" aria-selected="false">FIG_006: Reconciler Code</button>
            </div>
            <div style="padding: 8px 16px; font-family: var(--font-mono); font-size: 10.5px; color: var(--text-muted);">
              STATUS: <span style="color: var(--emerald-600);">LIVE INSTRUMENT</span>
            </div>
          </div>

          <!-- Panel 1: Delta Stream -->
          <div class="bench-content-panel" data-bench-panel="diff" data-active="true">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
              <div style="background: #0d1117; color: #c9d1d9; padding: 14px; font-family: var(--font-mono); font-size: 11.5px; border: 1px solid rgba(255,255,255,0.1);">
                <div style="color: #6e7681; margin-bottom: 8px;">// LIVE BUFFER [80×24 CELL GRID]</div>
                <div>┌──────────────────────────────────────┐</div>
                <div>│ <span style="color: #3fb950;">● OPENTUI CORE</span>  FPS: <span style="color: #58a6ff;">60.0</span>  CPU: 0.8% │</div>
                <div>├──────────────────────────────────────┤</div>
                <div>│ Mutation: <span style="background: rgba(16,185,129,0.3); color: #34d399;" id="lab-diff-token">render_loop_</span><span style="color: #6e7681;">       </span> │</div>
                <div>│ Status:   <span style="color: #3fb950;">STREAMING ACTIVE DELTAS</span>    │</div>
                <div>└──────────────────────────────────────┘</div>
              </div>
              <div>
                <div style="font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; color: var(--text-muted); margin-bottom: 6px;">
                  EMITTED ANSI ESCAPE STREAM:
                </div>
                <div style="font-family: var(--font-mono); font-size: 11.5px; background: rgba(0,0,0,0.03); border: 1px solid var(--border-color); padding: 12px; min-height: 100px; color: var(--foreground);" id="lab-escape-stream">
                  {"\\x1b[4;13H\\x1b[38;2;16;185;129mrender_loop_\\x1b[0m"}
                </div>
                <div style="display: flex; gap: 8px; margin-top: 10px;">
                  <button class="viewport-btn active" id="lab-btn-mutate">Mutate Buffer</button>
                  <button class="viewport-btn" id="lab-btn-repaint">Full Repaint (3,840 B)</button>
                </div>
              </div>
            </div>
          </div>

          <!-- Panel 2: Color Matrix -->
          <div class="bench-content-panel" data-bench-panel="matrix" data-active="false">
            <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 20px; align-items: start;">
              <div>
                <div style="display: flex; gap: 8px; margin-bottom: 12px;">
                  <button class="viewport-btn active" data-lab-preset="default">Default</button>
                  <button class="viewport-btn" data-lab-preset="amber">Amber CRT</button>
                  <button class="viewport-btn" data-lab-preset="green">VT220 Green</button>
                  <button class="viewport-btn" data-lab-preset="sepia">Sepia Archive</button>
                </div>
                <div style="display: grid; grid-template-columns: repeat(8, 1fr); gap: 3px; background: #000; padding: 10px;" id="lab-glyph-swatches">
                  <!-- Generated by script -->
                </div>
              </div>
              <div style="font-family: var(--font-mono); font-size: 11px; color: var(--text-muted);">
                <div style="margin-bottom: 8px;">SIMD MULTIPLICATION:</div>
                <div style="padding: 10px; background: rgba(0,0,0,0.03); border: 1px solid var(--border-color); line-height: 1.6;" id="lab-matrix-readout">
                  R' = 1.00 &middot; R + 0.00 &middot; G + 0.00 &middot; B<br/>
                  G' = 0.00 &middot; R + 1.00 &middot; G + 0.00 &middot; B<br/>
                  B' = 0.00 &middot; R + 0.00 &middot; G + 1.00 &middot; B
                </div>
              </div>
            </div>
          </div>

          <!-- Panel 3: Yoga Quantizer -->
          <div class="bench-content-panel" data-bench-panel="yoga" data-active="false">
            <div style="font-family: var(--font-mono); font-size: 11px; margin-bottom: 12px; color: var(--text-muted);">
              RESIZE CONTAINER (24 TO 60 COLUMNS):
            </div>
            <input type="range" id="lab-yoga-slider" min="24" max="60" value="48" style="width: 100%; height: 4px; margin-bottom: 16px;" />
            <div style="height: 100px; background: rgba(0,0,0,0.02); border: 1px solid var(--border-color); display: flex; padding: 8px; gap: 8px;" id="lab-yoga-container">
              <div style="width: 33.33%; background: rgba(14,165,233,0.1); border: 1px solid var(--cobalt-600); display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-size: 11px;" id="lab-yoga-nav">
                16 CH (33.3%)
              </div>
              <div style="width: 66.66%; background: rgba(16,185,129,0.1); border: 1px solid var(--emerald-600); display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-size: 11px;" id="lab-yoga-main">
                32 CH (66.7%)
              </div>
            </div>
          </div>

          <!-- Panel 4: Reconciler Code -->
          <div class="bench-content-panel" data-bench-panel="code" data-active="false">
            <pre style="margin: 0; font-family: var(--font-mono); font-size: 12.5px; line-height: 1.5; color: var(--foreground);"><code><span style="color: var(--rose-600);">import</span> &#123; createCliRenderer, Box, Text &#125; <span style="color: var(--rose-600);">from</span> <span style="color: var(--emerald-600);">"@opentui/core"</span>

<span style="color: var(--rose-600);">const</span> renderer = <span style="color: var(--rose-600);">await</span> createCliRenderer(&#123; exitOnCtrlC: <span style="color: var(--amber-600);">true</span> &#125;)

renderer.root.add(
  Box(
    &#123; borderStyle: <span style="color: var(--emerald-600);">"rounded"</span>, padding: <span style="color: var(--amber-600);">1</span>, flexDirection: <span style="color: var(--emerald-600);">"column"</span> &#125;,
    Text(&#123; content: <span style="color: var(--emerald-600);">"OpenTUI Systems Engine"</span>, fg: <span style="color: var(--emerald-600);">"#10b981"</span> &#125;)
  )
)</code></pre>

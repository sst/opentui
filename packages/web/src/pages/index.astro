---
import Base from "../layouts/Base.astro"
import OpenTUILogo from "../components/OpenTUILogo.astro"

// All listings are adapted from the docs pages they cite; they use only API
// shown on those pages and must be re-verified when those pages change.
const coreListing = `import { createCliRenderer, Box, Text } from "@opentui/core"

const renderer = await createCliRenderer()

renderer.root.add(
  Box(
    { borderStyle: "rounded", padding: 1 },
    Text({ content: "Hello, OpenTUI!" }),
  ),
)`

// Captured with createTestRenderer({ width: 25, height: 5 }) via
// setup.captureCharFrame(); regenerate if the listings change.
const capturedFrame = `╭───────────────────────╮
│                       │
│ Hello, OpenTUI!       │
│                       │
╰───────────────────────╯`

const indexData = [
  {
    part: "PART I: FIRST FRAME",
    entries: [
      { title: "Getting started", meta: "GUIDE", slug: "/docs/getting-started" },
      { title: "Renderer lifecycle", meta: "CORE CONCEPT", slug: "/docs/core-concepts/renderer" },
      { title: "Renderables", meta: "CORE CONCEPT", slug: "/docs/core-concepts/renderables" },
      { title: "Layout system", meta: "CORE CONCEPT", slug: "/docs/core-concepts/layout" },
    ]
  },
  {
    part: "PART II: TEXT, COLOR, AND CELLS",
    entries: [
      { title: "Text", meta: "COMPONENT", slug: "/docs/components/text" },
      { title: "Colors", meta: "CORE CONCEPT", slug: "/docs/core-concepts/colors" },
      { title: "Frame buffer", meta: "COMPONENT", slug: "/docs/components/frame-buffer" },
      { title: "Color matrix", meta: "REFERENCE", slug: "/docs/reference/color-matrix" },
    ]
  },
  {
    part: "PART III: INPUT AND COMPONENTS",
    entries: [
      { title: "Keyboard and input", meta: "CORE CONCEPT", slug: "/docs/core-concepts/keyboard" },
      { title: "Input component", meta: "COMPONENT", slug: "/docs/components/input" },
      { title: "Image component", meta: "COMPONENT", slug: "/docs/components/image" },
      { title: "Testing", meta: "CORE CONCEPT", slug: "/docs/core-concepts/testing" },
    ]
  },
  {
    part: "PART IV: APIS AND TRANSPORTS",
    entries: [
      { title: "React", meta: "BINDING", slug: "/docs/bindings/react" },
      { title: "Solid", meta: "BINDING", slug: "/docs/bindings/solid" },
      { title: "SSH", meta: "REFERENCE", slug: "/docs/reference/ssh" },
      { title: "Package entrypoints", meta: "REFERENCE", slug: "/docs/reference/package-entrypoints" },
    ]
  }
]
---

<Base
  title="OpenTUI - Terminal UIs on a native Zig core"
  description="Build interactive terminal applications with TypeScript, React, or Solid on OpenTUI's native Zig core."
>
  <div class="editorial-wrapper">
    <div class="editorial-container">

      <!-- Quiet Editorial Masthead: no brand mark here, the logo below is the page's one brand occurrence -->
      <div class="editorial-masthead">
        <div class="editorial-masthead-nav">
          <a href="/docs/getting-started">Documentation</a>
          <a href="https://github.com/anomalyco/opentui" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>

      <!-- Product Hero -->
      <header class="editorial-hero">
        <OpenTUILogo class="hero-logo-mark" title="OpenTUI" />
        <h1 class="hero-headline">
          Terminal UIs on a native Zig core.
        </h1>
        <p class="editorial-lead-desc">
          OpenTUI is a TypeScript library for building interactive terminal applications. Write components with the imperative API, or with React and Solid over the same renderer. Yoga resolves Flexbox layout, and a native Zig core turns each frame into terminal output.
        </p>
        <div class="hero-start">
          <code class="hero-start-cmd">$ bun create tui</code>
        </div>
      </header>

      <!-- Illustrated Introduction: Front Matter -->
      <section class="editorial-frontmatter">
        <h2 class="frontmatter-title">Between your code and the screen.</h2>
        <p class="frontmatter-subtitle">
          What you write, what OpenTUI does, and where to go next.
        </p>
      </section>

      <p class="editorial-intro">
        Build a tree of boxes, text, inputs, and images. OpenTUI resolves its layout, routes input through it, composes it into terminal cells, and writes the resulting updates. Use the core API directly, or let React and Solid drive the same renderables.
      </p>

      <!-- FIG_01: The interface you write -->
      <figure class="editorial-figure editorial-lead-figure">
        <span class="fig-tag-top-left">FIG_01</span>
        <span class="fig-tag-top-right">[ ONE RENDERABLE TREE ]</span>

        <div class="figure-code-grid">
          <div>
            <span class="figure-code-label">Source</span>
            <pre class="figure-code"><code>{coreListing}</code></pre>
          </div>
          <div>
            <span class="figure-code-label">Output</span>
            <div class="figure-output-wrap">
              <pre class="figure-output"><code>{capturedFrame}</code></pre>
            </div>
          </div>
        </div>

        <div class="figure-caption-text">
          <code>renderer.root.add(...)</code> attaches this tree; the renderer resolves it into the frame above. <code>@opentui/react</code> and <code>@opentui/solid</code> render the same tree over the same renderer.
        </div>
      </figure>

      <p class="editorial-intro-links">
        <a href="/docs/getting-started">Getting started</a> &middot; <a href="/docs/core-concepts/renderables">Renderables</a> &middot; <a href="/docs/bindings/react">React</a> &middot; <a href="/docs/bindings/solid">Solid</a>
      </p>

      <!-- Editorial Multi-Column Flow -->
      <div class="editorial-flow">

        <!-- FIG_02: The layout you declare -->
        <figure class="editorial-figure">
          <span class="fig-tag-top-left">FIG_02</span>
          <span class="fig-tag-top-right">[ RESOLVED LAYOUT BOUNDS ]</span>

          <div class="figure-canvas-wrap">
            <svg viewBox="0 0 380 170" width="380" height="170" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Flexible constraint box -->
              <rect x="30" y="30" width="140" height="70" fill="rgba(14, 165, 233, 0.08)" stroke="var(--cobalt-600)" stroke-width="1.2" stroke-dasharray="3 3"/>
              <text x="100" y="20" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--cobalt-600)">FLEXIBLE: width 33.3%</text>

              <!-- Resolution arrow -->
              <path d="M185 65 L215 65" stroke="currentColor" stroke-width="1.2"/>
              <text x="200" y="55" text-anchor="middle" font-family="var(--font-mono)" font-size="8" fill="currentColor">RESOLVE</text>

              <!-- Discrete integer cells -->
              <g transform="translate(225, 30)">
                <rect x="0" y="0" width="130" height="70" fill="rgba(14, 165, 233, 0.15)" stroke="currentColor" stroke-width="1.2"/>
                <line x1="26" y1="0" x2="26" y2="70" stroke="currentColor" stroke-width="0.5"/>
                <line x1="52" y1="0" x2="52" y2="70" stroke="currentColor" stroke-width="0.5"/>
                <line x1="78" y1="0" x2="78" y2="70" stroke="currentColor" stroke-width="0.5"/>
                <line x1="104" y1="0" x2="104" y2="70" stroke="currentColor" stroke-width="0.5"/>
                <text x="65" y="40" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="currentColor">16 COLUMNS</text>
              </g>

              <text x="190" y="140" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--text-muted)">RESIZE: SAME TREE &middot; NEW CONSTRAINTS</text>
            </svg>
          </div>

          <div class="figure-caption-text">
            Yoga resolves Flexbox-like constraints &mdash; direction, grow, shrink, padding, percentage widths &mdash; against the terminal's available rows and columns; OpenTUI uses the resulting bounds to place renderables on the cell grid.
          </div>
          <span class="fig-tag-bottom-left">YOGA LAYOUT</span>
          <span class="fig-tag-bottom-right">PROPS &rarr; CELLS</span>
        </figure>

        <p>
          For ordinary layout, you position nothing by hand. You set <code>flexDirection</code>, <code>flexGrow</code>, <code>padding</code>, and percentage sizes on containers, and Yoga resolves the tree against the terminal's current width and height; absolute positioning remains available when you need it. When the terminal is resized, the same tree is resolved against the new constraints; your components do not change.
        </p>

        <p>
          The resolved bounds determine more than where a border is drawn. They determine where text wraps, how much of a scrollable region is visible, and where mouse interaction lands. Layout is continuous while it is being described and discrete when it reaches the terminal: the result must occupy whole columns and rows.
        </p>

        <p class="flow-refs">
          Continue reading: <a href="/docs/core-concepts/layout">Layout</a> &middot; <a href="/docs/core-concepts/renderables">Renderables</a>
        </p>

        <p>
          Rendering also establishes where interaction can happen. Focus a component and keyboard events route to it; <code>renderer.keyInput</code> emits structured key events with the parsed key name, modifiers, and the original terminal sequence, and paste arrives as its own event. Mouse events follow the resolved bounds of whatever is beneath the pointer. Input handling belongs to OpenTUI as a whole &mdash; parsing, focus, and routing are part of the same renderer that draws the frame.
        </p>

        <p class="flow-refs">
          Continue reading: <a href="/docs/core-concepts/keyboard">Keyboard and input</a> &middot; <a href="/docs/components/input">Input component</a>
        </p>

        <!-- FIG_03: The text you set -->
        <figure class="editorial-figure">
          <span class="fig-tag-top-left">FIG_03</span>
          <span class="fig-tag-top-right">[ THE LOGICAL CELL ]</span>

          <div class="figure-canvas-wrap">
            <svg viewBox="0 0 420 240" width="420" height="240" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Isometric Layer 1: tagged character field -->
              <g transform="translate(50, 16)">
                <path d="M120 10 L220 62 L120 114 L20 62 Z" fill="rgba(14, 165, 233, 0.08)" stroke="currentColor" stroke-width="1"/>
                <path d="M20 62 L20 78 L120 130 L120 114 Z" fill="rgba(14, 165, 233, 0.14)" stroke="currentColor" stroke-width="1"/>
                <path d="M220 62 L220 78 L120 130 L120 114 Z" fill="rgba(14, 165, 233, 0.20)" stroke="currentColor" stroke-width="1"/>

                <line x1="120" y1="40" x2="260" y2="40" stroke="var(--cobalt-600)" stroke-width="0.8" stroke-dasharray="2 2"/>
                <circle cx="120" cy="40" r="2" fill="var(--cobalt-600)"/>
                <text x="265" y="43" font-family="var(--font-mono)" font-size="10" fill="var(--cobalt-600)">char: u32 (tagged)</text>
              </g>

              <!-- Isometric Layer 2: foreground and background color -->
              <g transform="translate(50, 46)">
                <path d="M120 10 L220 62 L120 114 L20 62 Z" fill="rgba(16, 185, 129, 0.08)" stroke="currentColor" stroke-width="1"/>
                <path d="M20 62 L20 78 L120 130 L120 114 Z" fill="rgba(16, 185, 129, 0.14)" stroke="currentColor" stroke-width="1"/>
                <path d="M220 62 L220 78 L120 130 L120 114 Z" fill="rgba(16, 185, 129, 0.20)" stroke="currentColor" stroke-width="1"/>

                <line x1="120" y1="62" x2="260" y2="88" stroke="var(--emerald-600)" stroke-width="0.8" stroke-dasharray="2 2"/>
                <circle cx="120" cy="62" r="2" fill="var(--emerald-600)"/>
                <text x="265" y="91" font-family="var(--font-mono)" font-size="10" fill="var(--emerald-600)">fg &middot; bg: RGBA</text>
              </g>

              <!-- Isometric Layer 3: style attributes -->
              <g transform="translate(50, 76)">
                <path d="M120 10 L220 62 L120 114 L20 62 Z" fill="rgba(217, 119, 6, 0.08)" stroke="currentColor" stroke-width="1"/>
                <path d="M20 62 L20 78 L120 130 L120 114 Z" fill="rgba(217, 119, 6, 0.14)" stroke="currentColor" stroke-width="1"/>
                <path d="M220 62 L220 78 L120 130 L120 114 Z" fill="rgba(217, 119, 6, 0.20)" stroke="currentColor" stroke-width="1"/>

                <line x1="120" y1="62" x2="260" y2="136" stroke="var(--amber-600)" stroke-width="0.8" stroke-dasharray="2 2"/>
                <circle cx="120" cy="62" r="2" fill="var(--amber-600)"/>
                <text x="265" y="139" font-family="var(--font-mono)" font-size="10" fill="var(--amber-600)">attributes: u32</text>
              </g>
            </svg>
          </div>

          <div class="figure-caption-text">
            The native buffer represents a terminal frame through parallel character, color, and attribute data. A logical cell combines character or grapheme information with foreground color, background color, and style attributes; tagged values also represent image and continuation cells.
          </div>
          <span class="fig-tag-bottom-left">OPENTUI CORE</span>
          <span class="fig-tag-bottom-right">CHAR &middot; FG &middot; BG &middot; ATTRS</span>
        </figure>

        <p>
          You set <code>content</code> on a text renderable and move on. OpenTUI's job is to make that honest on a cell grid, because a cell is not the same thing as a character in a JavaScript string. A grapheme is not a byte, a code point, or a UTF-16 code unit: several code points can form one grapheme, and a wide grapheme can begin in one column and continue through another.
        </p>

        <p>
          OpenTUI keeps those distinctions in the frame. The character field can identify a direct scalar, a grapheme stored elsewhere, an image cell, or a continuation. Foreground and background colors and text attributes travel with it. This is why wrapping, truncation, and cursor movement stay correct when your strings contain emoji, CJK text, or combining marks &mdash; and why tests can capture the frame as plain text or inspect structured spans containing text, width, colors, and attributes.
        </p>

        <p class="flow-refs">
          Continue reading: <a href="/docs/components/text">Text</a> &middot; <a href="/docs/core-concepts/colors">Colors</a> &middot; <a href="/docs/core-concepts/testing">Testing</a>
        </p>

        <!-- FIG_04: The updates you make -->
        <figure class="editorial-figure">
          <span class="fig-tag-top-left">FIG_04</span>
          <span class="fig-tag-top-right">[ CELL-BY-CELL DIFF ]</span>

          <div class="figure-canvas-wrap">
            <svg viewBox="0 0 380 180" width="380" height="180" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Previous frame -->
              <rect x="20" y="30" width="110" height="85" fill="var(--background)" stroke="currentColor" stroke-width="1"/>
              <text x="75" y="20" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="currentColor">PREVIOUS FRAME</text>
              <line x1="20" y1="58" x2="130" y2="58" stroke="currentColor" stroke-width="0.5" stroke-dasharray="2 2"/>
              <line x1="20" y1="86" x2="130" y2="86" stroke="currentColor" stroke-width="0.5" stroke-dasharray="2 2"/>

              <!-- Comparison arrow -->
              <path d="M145 72 L185 72" stroke="var(--emerald-600)" stroke-width="1.2"/>
              <text x="165" y="64" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--emerald-600)">CELL DIFF</text>

              <!-- Current frame with changed run -->
              <rect x="200" y="30" width="110" height="85" fill="var(--background)" stroke="currentColor" stroke-width="1"/>
              <text x="255" y="20" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="currentColor">CURRENT FRAME</text>
              <rect x="220" y="45" width="50" height="30" fill="rgba(16, 185, 129, 0.15)" stroke="var(--emerald-600)" stroke-width="1.5"/>
              <text x="245" y="63" text-anchor="middle" font-family="var(--font-mono)" font-size="8" fill="var(--emerald-600)">CHANGED RUN</text>

              <!-- Update stream output -->
              <rect x="20" y="130" width="340" height="32" fill="rgba(0,0,0,0.03)" stroke="currentColor" stroke-width="0.8"/>
              <text x="32" y="150" font-family="var(--font-mono)" font-size="9.5" fill="currentColor">{"\\x1b[4;12H\\x1b[38;2;16;185;129mACTIVE\\x1b[0m"}</text>
              <text x="345" y="150" text-anchor="end" font-family="var(--font-mono)" font-size="8.5" fill="var(--emerald-600)">[UPDATE STREAM]</text>
            </svg>
          </div>

          <div class="figure-caption-text">
            For ordinary updates, the renderer compares the current cell frame with the previous one and builds terminal output for the cells and terminal state that changed.
          </div>
          <span class="fig-tag-bottom-left">FRAME COMPARISON</span>
          <span class="fig-tag-bottom-right">CHANGED CELLS</span>
        </figure>

        <p>
          You change state &mdash; a label, a cursor position, one row of results &mdash; and you are done. You do not schedule redraws, track damage, or decide what to repaint. OpenTUI composes the next frame as a complete surface, compares it with the previous one, and writes output only for what changed.
        </p>

        <p>
          Changed runs carry the cursor movement, color and attribute state, and encoded text needed to update those positions. An unchanged render can produce no cell updates; a resize or screen-mode transition can require more work than a small cell diff. The useful property is not an absolute promise of "no redraws." It is that the frame and its update are both explicit objects you can inspect: tests capture frames with <code>createTestRenderer</code>, and frame-buffer operations such as 4&times;4 color-matrix transforms act on the frame directly without touching your component tree.
        </p>

        <p class="flow-refs">
          Continue reading: <a href="/docs/core-concepts/renderer">Renderer</a> &middot; <a href="/docs/core-concepts/testing">Testing</a> &middot; <a href="/docs/reference/color-matrix">Color matrix</a>
        </p>

        <!-- FIG_05: The images you render -->
        <figure class="editorial-figure">
          <span class="fig-tag-top-left">FIG_05</span>
          <span class="fig-tag-top-right">[ IMAGE PROTOCOL RESOLUTION ]</span>

          <div class="figure-canvas-wrap">
            <svg viewBox="0 0 380 150" width="380" height="150" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Kitty -->
              <rect x="30" y="20" width="95" height="85" fill="rgba(14, 165, 233, 0.1)" stroke="var(--cobalt-600)" stroke-width="1"/>
              <text x="77" y="40" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="currentColor">AUTO &middot; 1</text>
              <text x="77" y="60" text-anchor="middle" font-family="var(--font-mono)" font-size="10" font-weight="bold" fill="var(--cobalt-600)">KITTY</text>
              <text x="77" y="80" text-anchor="middle" font-family="var(--font-mono)" font-size="8" fill="var(--text-muted)">GRAPHICS PROTOCOL</text>

              <!-- Sixel -->
              <rect x="142" y="20" width="95" height="85" fill="rgba(217, 119, 6, 0.1)" stroke="var(--amber-600)" stroke-width="1"/>
              <text x="189" y="40" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="currentColor">AUTO &middot; 2</text>
              <text x="189" y="60" text-anchor="middle" font-family="var(--font-mono)" font-size="10" font-weight="bold" fill="var(--amber-600)">SIXEL</text>
              <text x="189" y="80" text-anchor="middle" font-family="var(--font-mono)" font-size="8" fill="var(--text-muted)">NEEDS PIXEL GEOMETRY</text>

              <!-- Unicode blocks -->
              <rect x="254" y="20" width="95" height="85" fill="rgba(16, 185, 129, 0.1)" stroke="var(--emerald-600)" stroke-width="1"/>
              <text x="301" y="40" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="currentColor">AUTO &middot; 3</text>
              <text x="301" y="60" text-anchor="middle" font-family="var(--font-mono)" font-size="10" font-weight="bold" fill="var(--emerald-600)">BLOCKS</text>
              <text x="301" y="80" text-anchor="middle" font-family="var(--font-mono)" font-size="8" fill="var(--text-muted)">▀ ▄ █ QUADRANTS</text>

              <text x="190" y="130" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--text-muted)">AUTO: GLOBAL OVERRIDE &rarr; KITTY &rarr; SIXEL &rarr; BLOCKS</text>
            </svg>
          </div>

          <div class="figure-caption-text">
            With image protocol selection set to <code>auto</code>, OpenTUI resolves the configured override and available terminal capabilities to Kitty graphics, Sixel, or Unicode quadrant blocks.
          </div>
          <span class="fig-tag-bottom-left">PROTOCOL SELECTION</span>
          <span class="fig-tag-bottom-right">AUTO-DETECTED</span>
        </figure>

        <p>
          You add an image component and point it at a file. Which bytes reach the terminal depends on the terminal: some emulators accept Kitty graphics, some accept Sixel, and every environment reports different capabilities during startup, resize, remote transport, or multiplexing.
        </p>

        <p>
          OpenTUI keeps that decision at the image-rendering boundary so your component does not change per terminal. In automatic mode, the documented order is the global override, then Kitty, then Sixel, then Unicode blocks. Sixel requires terminal pixel geometry and temporarily falls back to blocks when that geometry is unavailable; tmux and overlapping images introduce additional constraints documented with the image component. The block path is not an error state &mdash; it maps sampled image colors into the same foreground, background, and cell grid used by the rest of the frame.
        </p>

        <p class="flow-refs">
          Continue reading: <a href="/docs/components/image">Image component</a> &middot; <a href="/docs/reference/native-image">Native image loading</a> &middot; <a href="/docs/reference/env-vars">Environment overrides</a>
        </p>

        <p>
          These mechanisms meet at <code>CliRenderer</code>. It manages the terminal session, input events, the render loop, and the output boundary while loading the native Zig rendering library underneath. A renderer takes responsibility for the terminal, then gives it back: it enters the selected screen mode, configures terminal features, receives input, writes frames, and restores the terminal's state during cleanup. The details differ across local terminals, custom streams, and SSH sessions; the boundary remains explicit.
        </p>

        <p>
          You have already seen the whole surface area: <code>@opentui/core</code> for the imperative API and component primitives, <code>@opentui/react</code> and <code>@opentui/solid</code> for declarative APIs over the same renderer, and a native core with a C ABI underneath all three. The index below follows each part into the documentation.
        </p>

      </div>

      <!-- Reading Index -->
      <section class="toc-section" id="index">
        <div class="toc-header">
          <h2 class="toc-heading">Reading index.</h2>
          <span class="toc-version">DOCUMENTATION ROUTES</span>
        </div>

        <div class="toc-grid">
          {indexData.map((part) => (
            <div class="toc-part-card">
              <div class="toc-part-label">{part.part}</div>
              <ul class="toc-chapter-list">
                {part.entries.map((entry) => (
                  <li class="toc-chapter-item">
                    <a href={entry.slug}>
                      <span>{entry.title}</span>
                      <span class="chapter-words">{entry.meta}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- Editorial Footer -->
      <footer class="editorial-footer">
        <div class="footer-top">
          <div class="footer-identity">
            <OpenTUILogo class="manual-logo-mark" style="width: 72px; height: 16px;" />
            <span style="font-weight: 500; color: var(--foreground);">BETWEEN YOUR CODE AND THE SCREEN</span>
          </div>
          <div class="footer-links">
            <a href="/docs/getting-started">Documentation</a>
            <a href="/docs/core-concepts/renderer">Renderer</a>
            <a href="/docs/core-concepts/layout">Layout</a>
            <a href="https://github.com/anomalyco/opentui" target="_blank" rel="noopener noreferrer">GitHub</a>
          </div>
        </div>

        <div class="footer-bottom">
          <div>Open source under the MIT License &middot; Native Zig and TypeScript</div>
          <div>ANOMALY</div>
        </div>
      </footer>

    </div>
  </div>
</Base>

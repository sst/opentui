{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "noEmit": false,
    "rootDir": ".",
    "types": ["bun", "node", "react"],
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@opentui/core": ["../core/dist/index.d.ts"],
      "@opentui/core/testing": ["../core/dist/testing.d.ts"],
      "@opentui/core/runtime-plugin": ["../core/dist/runtime-plugin.d.ts"],
      "@opentui/core/*": ["../core/dist/*"],
      "react-reconciler/constants": ["./node_modules/@types/react-reconciler/constants.d.ts"]
    }
  },
  "include": [
    "src/**/*",
    "jsx-runtime.d.ts",
    "jsx-dev-runtime.d.ts",
    "jsx-namespace.d.ts",
    "scripts/runtime-plugin-support.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "examples/**/*",
    "node_modules/**/*",
    "../core/**/*",
    "scripts/build.ts",
    "scripts/publish.ts"
  ]
}

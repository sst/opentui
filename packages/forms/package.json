    "./react": {
      "types": "./src/react.ts",
      "import": "./src/react.ts"
    },
    "./solid": {
      "types": "./src/solid.ts",
      "import": "./src/solid.ts"
    }
  },
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {

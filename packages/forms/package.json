{
  "name": "@opentui/forms",
  "version": "0.0.0",
  "description": "Form primitives (radio buttons, checkboxes, etc.) for OpenTUI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anomalyco/opentui",
    "directory": "packages/forms"
  },
  "types": "src/index.ts",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"

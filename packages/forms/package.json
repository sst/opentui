{
  "name": "@opentui/forms",
  "version": "0.4.3",
  "description": "Form primitives (radio buttons, checkboxes, etc.) for OpenTUI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anomalyco/opentui",
    "directory": "packages/forms"
  },
  "keywords": [
    "opentui",
    "tui",
    "terminal",
    "forms",
    "radio-button"
  ],
  "types": "src/index.ts",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "import": "./src/react.ts"
    },
    "./solid": {
      "types": "./src/solid.ts",
      "import": "./src/solid.ts"
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "publish": "bun scripts/publish.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@opentui/core": "workspace:*"
  },
  "peerDependencies": {
    "@opentui/react": "workspace:*",
    "@opentui/solid": "workspace:*",
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "@opentui/react": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentui/react": "workspace:*",
    "@opentui/solid": "workspace:*",
    "@types/bun": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "react": ">=19.2.0",
    "solid-js": "1.9.12",
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}

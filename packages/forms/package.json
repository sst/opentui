    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "@opentui/react": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentui/react": "workspace:*",
    "@opentui/solid": "workspace:*",
    "@types/bun": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "react": ">=19.2.0",
    "solid-js": "1.9.12"
  }
}
